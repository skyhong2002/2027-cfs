													<div>
														<>
															<span>{l("開源築夢計畫", "Student support program")}</span>
															<p>{l("參與票券＋交通與住宿補助；不限偏鄉學生。", "Participation ticket plus travel and accommodation support; not limited to rural areas.")}</p>
														</>
													</div>
												</>
											</div>
										</>
									</div>
									<div class="dream-panel">
										<>
											<span class="pill">{l("2027 新計畫・方案草案", "NEW FOR 2027 · DRAFT")}</span>
