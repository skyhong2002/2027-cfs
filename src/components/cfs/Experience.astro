---
import { loadItemsData } from "../../utils/items-loader";
import plans from "../../data/plan.json";
import { parseReferencePrice } from "../../utils/proposal";
import HeroPhoto from "../../assets/img/2027/sitcon-2025-auditorium.jpg";
import BoothPhoto from "../../assets/img/2027/sitcon-2025-partner-booth.jpg";
import TalkPhoto from "../../assets/img/2027/sitcon-2025-project-talk.jpg";
import CommunityPhoto from "../../assets/img/2027/sitcon-2025-community-exchange.jpg";
import { marked } from "marked";
import "../../styles/cfs.css";

interface Props {
	lang?: string;
	initialItem?: string;
	quoteOnly?: boolean;
}
const { lang = "zh-Hant", initialItem = "", quoteOnly = false } = Astro.props;
const en = lang === "en";
const l = (zh: string, english: string) => (en ? english : zh);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = `${base}/${en ? "en/" : ""}`;
const items = (await loadItemsData(lang)).filter(item => item.id !== "18").sort((a, b) => a.order - b.order);
const tiers = Object.values(plans).sort((a, b) => b.order - a.order);
const names: Record<string, string> = Object.fromEntries(items.map(item => [item.id, item.name]));
const benefitName = (benefit: { item_id: string; item_name: string }) =>
	names[benefit.item_id] || (en ? { "Instagram 精選動態": "Instagram highlights", "Facebook 粉絲專頁貼文": "Facebook posts" }[benefit.item_name] || benefit.item_name : benefit.item_name);
const benefits = plans.navigator.benefits;
const pageTitle = `${initialItem ? `${names[initialItem] || ""} · ` : ""}${quoteOnly ? l("合作清單 · ", "Proposal · ") : ""}SITCON 2027 · ${l("贊助合作提案", "Partner with the next generation")}`;
const displayPrice = (value: string) => {
	const amount = parseReferencePrice(value);
	return amount === null ? l("價格待確認", "Pricing pending") : `NT$${amount.toLocaleString("en-US")}`;
};
const priceText = (item: (typeof items)[number]) => {
	if (!item.sub.length) return displayPrice(item.price);
	const amounts = item.sub.map(sub => parseReferencePrice(sub.price));
	if (amounts.some(amount => amount === null)) return l("價格待確認", "Pricing pending");
	return `NT$${Math.min(...amounts.map(amount => amount!)).toLocaleString("en-US")} ${l("起", "and up")}`;
};
const tierIntent = (tier: { id: string; intent_zh?: string; intent_en?: string }) => (en ? tier.intent_en : tier.intent_zh) || l("一起討論適合的合作方向", "Discuss the right partnership direction");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content={l(
				"SITCON 2027 贊助合作提案：認識學生技術社群、比較贊助方案、支持開源築夢計畫，整理適合您的合作方式。",
				"Explore SITCON 2027 sponsorship: meet the student tech community, compare partnership tiers, and support student participation."
			)}
		/>
		<meta name="robots" content="noindex, nofollow" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta
			property="og:description"
			content={l(
				"SITCON 2027 贊助合作討論預覽：探索合作方向、開源築夢與候選品項，整理需求並開始洽談。",
				"SITCON 2027 sponsorship preview: explore partnership directions, student support, and candidate options, then prepare your inquiry."
			)}
		/>
		<meta property="og:url" content={new URL(home, Astro.site || "https://sitcon.org").href} />
		<meta property="og:image" content={new URL(HeroPhoto.src, Astro.site || "https://sitcon.org").href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#174c3c" />
		<title>{pageTitle}</title>
		<link rel="icon" href={`${base}/favicon/favicon.ico`} />
	</head>
	<body data-base={base} data-home={home} data-initial-item={initialItem} data-quote-only={String(quoteOnly)}>
		<a class="skip-link" href="#main">{l("跳到主要內容", "Skip to content")}</a>
		<div class="preview-ribbon">{l("2027 贊助徵求書・討論預覽版", "2027 SPONSORSHIP · DISCUSSION PREVIEW")}<span>{l("方案與權益待確認", "Plans and benefits subject to confirmation")}</span></div>
		<header class="site-header">
			<a class="brand" href={home} aria-label="SITCON 2027">
				<img src={`${base}/SITCON.svg`} alt="" width="23" height="33" /><b class="brand-wordmark">SITCON</b><span>2027<span class="brand-sub">{l("贊助合作提案", "SPONSORSHIP")}</span></span>
			</a>
			<button class="menu-toggle" aria-controls="main-nav" aria-expanded="false">{l("選單", "Menu")} <span aria-hidden="true">☰</span></button>
			<nav id="main-nav" aria-label={l("主要導覽", "Main navigation")}>
				<a href={`${quoteOnly ? home : ""}#opportunities`}>{l("合作機會", "Opportunities")}</a>
				<a href={`${quoteOnly ? home : ""}#plans`}>{l("方案比較", "Plans")}</a>
				<a href={`${quoteOnly ? home : ""}#dream`}>{l("開源築夢", "Student support")}</a>
				<a href={`${base}/${en ? "" : "en/"}${initialItem ? `item/${initialItem}/` : quoteOnly ? "quotation/" : ""}`}>{en ? "中文" : "EN"}</a>
				<a class="nav-cta" href={`${quoteOnly ? home : ""}#contact`}>{l("聊聊合作", "Let’s talk")} <span aria-hidden="true">↗</span></a>
			</nav>
		</header>
		<main id="main">
			<noscript>
				<div class="wrap reference-note">
					{
						l(
							"瀏覽器未啟用 JavaScript，合作清單與信件草稿無法互動。您仍可瀏覽內容，並來信 contact@sitcon.org 洽談。",
							"JavaScript is disabled, so the proposal and draft tools are unavailable. You can still browse and contact contact@sitcon.org."
						)
					}
				</div>
			</noscript>
			{
				!quoteOnly && (
					<>
						<section class="hero wrap" id="overview">
							<div class="hero-copy">
								<p class="eyebrow">
									<span class="live-dot" /> STUDENTS × TECHNOLOGY × COMMUNITY
								</p>
								<h1>
									{l("讓學生的下一步，", "Make room for")}
									<br />
									<em>{l("與你一起發生。", "what’s next.")}</em>
								</h1>
								<p class="hero-description">
									{l(
										"SITCON 是由學生發起的資訊年會。與正在實作、分享與探索技術的年輕人相遇，找到人才、品牌與教育支持的合作機會。",
										"SITCON is a technology conference organized by students. Meet young people who build, share, and explore—and find your place in their next chapter."
									)}
								</p>
								<div class="hero-actions">
									<>
										<a class="button primary" href="#plans">
											{l("找到適合的合作方案", "Explore partnership plans")} <span aria-hidden="true">↗</span>
										</a>
										<a class="text-link" href="#highlights">
											{l("已經認識我們？看今年重點", "Know us already? See what’s new")} <span aria-hidden="true">↓</span>
										</a>
									</>
								</div>
								<div class="event-facts">
									<>
										<div>
											<>
												<span>{l("年會日期", "DATE")}</span>
												<strong>
													2027.03.13 <small>SAT</small>
												</strong>
											</>
										</div>
										<div>
											<>
												<span>{l("活動地點", "VENUE")}</span>
												<strong>{l("中央研究院", "Academia Sinica")}</strong>
												<p>{l("人文社會科學館・臺北", "Humanities & Social Sciences Building, Taipei")}</p>
											</>
										</div>
									</>
								</div>
							</div>
							<figure class="hero-photo">
								<>
									<img src={HeroPhoto.src} alt={l("SITCON 年會講堂與會眾", "Conference auditorium and participants at SITCON")} width="1024" height="683" fetchpriority="high" />
									<div class="photo-stamp">
										{l("學生的舞台", "BUILT BY STUDENTS")}
										<br />
										<b>{l("產業的未來", "FOR WHAT’S NEXT")}</b>
									</div>
								</>
							</figure>
						</section>
						<div class="section-index wrap">
							<>
								<span>{l("從一個想法，到一次合作", "FROM AN IDEA TO A PARTNERSHIP")}</span>
								<a href="#opportunities">01 {l("認識受眾", "Community")}</a>
								<a href="#plans">02 {l("比較方案", "Compare")}</a>
								<a href="#items">03 {l("選配品項", "Customize")}</a>
								<a href="#proposal">04 {l("整理需求", "Connect")}</a>
							</>
						</div>

						<section id="opportunities" class="opportunities section-pad">
							<div class="wrap">
								<div class="section-heading">
									<>
										<div>
											<>
												<p class="eyebrow">01 / MEET YOUR FUTURE COMMUNITY</p>
												<h2>
													{l("你的下一位夥伴，", "Your next collaborator")}
													<br />
													{l("可能就在這裡。", "could be here.")}
												</h2>
											</>
										</div>
										<p>
											{l(
												"從第一個開源專案，到第一次技術分享。SITCON 讓學生展示所學，也讓企業有機會走進真實的技術交流。",
												"From a first open-source project to a first technical talk. SITCON gives students a place to share their work, and companies a way to join the conversation."
											)}
										</p>
									</>
								</div>
								<div class="stats-strip">
									<>
										<div>
											<>
												<strong>
													—<small>{l("待確認", "Pending")}</small>
												</strong>
												<span>{l("2027 預計參與規模", "Expected 2027 attendance")}</span>
											</>
										</div>
										<div>
											<>
												<strong>
													—<small>{l("待確認", "Pending")}</small>
												</strong>
												<span>{l("2027 受眾背景與學校分布", "2027 audience and school profile")}</span>
											</>
										</div>
										<div>
											<>
												<strong>
													—<small>{l("待確認", "Pending")}</small>
												</strong>
												<span>{l("2027 求職／實習意向", "2027 job and internship interests")}</span>
											</>
										</div>
									</>
								</div>
								<p class="source-note">
									{l(
										"2027 受眾與曝光資料尚待主辦方確認。本版不以歷年統計推估本屆成果。",
										"2027 audience and reach data await organizer confirmation. This preview does not substitute historical figures for this year’s outcomes."
									)}
								</p>
								<div class="opportunity-grid">
									<article>
										<>
											<figure class="story-photo">
												<img src={BoothPhoto.src} alt={l("企業攤位與參與者交流", "Partners talking with participants")} width="600" height="360" loading="lazy" />
											</figure>
											<span class="card-number">01 / TALENT</span>
											<h3>{l("在對話裡，認識人才。", "Meet talent through conversation.")}</h3>
											<p>
												{l(
													"透過會場攤位與學生交流作品、技術興趣及職涯方向。把職缺介紹變成一次能互相了解的對話。",
													"Use a booth to talk about projects, technical interests, and career paths. Turn a job description into a real conversation."
												)}
											</p>
											<a href="#plans" class="text-link">
												{l("討論現場交流方案", "Explore in-person engagement")} ↗
											</a>
										</>
									</article>
									<article>
										<>
											<figure class="story-photo">
												<img src={TalkPhoto.src} alt={l("講者在舞台分享技術專案", "A speaker presenting a technical project")} width="600" height="360" loading="lazy" />
											</figure>
											<span class="card-number">02 / BRAND & PRODUCT</span>
											<h3>{l("讓技術社群，認識你。", "Bring your brand into the community.")}</h3>
											<p>
												{l(
													"搭配現場展示、數位曝光與內容分享，說清楚你的產品可以解決什麼問題，創造學生進一步了解的機會。",
													"Combine on-site visibility and digital content to show what your product does and invite students to learn more."
												)}
											</p>
											<a href="#items" class="text-link">
												{l("探索曝光與推廣品項", "Explore visibility options")} ↗
											</a>
										</>
									</article>
									<article>
										<>
											<figure class="story-photo">
												<img src={CommunityPhoto.src} alt={l("參與者圍桌討論技術", "Participants discussing technology")} width="600" height="360" loading="lazy" />
											</figure>
											<span class="card-number">03 / EDUCATION</span>
											<h3>{l("把參與機會，帶得更遠。", "Make participation possible.")}</h3>
											<p>
												{l(
													"透過開源築夢計畫支持有經濟需求的學生，降低交通與住宿帶來的參與門檻，讓學習機會不被距離限制。",
													"Support students facing financial barriers through the student support program, helping with travel and accommodation."
												)}
											</p>
											<a href="#dream" class="text-link">
												{l("了解開源築夢計畫", "Explore student support")} ↗
											</a>
										</>
									</article>
								</div>
							</div>
						</section>

						<section class="wrap highlights section-pad" id="highlights">
							<>
								<div>
									<>
										<p class="eyebrow">2027 / AT A GLANCE</p>
										<h2>{l("今年，從這裡開始。", "A new year. A clearer way to partner.")}</h2>
										<p>{l("熟悉 SITCON 的你，可以直接從新的支持計畫與合作選擇開始。", "Returning partners can start with the new support program and explore their options directly.")}</p>
									</>
								</div>
								<div class="highlight-list">
									<>
										<a href="#dream">
											<>
												<span>01</span>
												<div>
													<>
														<h3>{l("開源築夢計畫", "Student support program")}</h3>
														<p>{l("票券之外，進一步支持交通與住宿。", "Support participation, travel, and accommodation.")}</p>
													</>
												</div>
												<b>↗</b>
											</>
										</a>
										<a href="#plans">
											<>
												<span>02</span>
												<div>
													<>
														<h3>{l("整理適合的合作方向", "Explore your partnership direction")}</h3>
														<p>{l("先比較合作層級，再按需求選配。", "Compare tiers first, then customize your proposal.")}</p>
													</>
												</div>
												<b>↗</b>
											</>
										</a>
										<a href="#proposal">
											<>
												<span>03</span>
												<div>
													<>
														<h3>{l("帶著一份清單，開始聊", "Start with a shared proposal")}</h3>
														<p>{l("整理方案、品項與問題，方便內部討論與聯絡。", "Bring your plans, options, and questions into one place.")}</p>
													</>
												</div>
												<b>↗</b>
											</>
										</a>
									</>
								</div>
							</>
						</section>

						<section id="plans" class="plans-section section-pad">
							<div class="wrap">
								<div class="section-heading">
									<>
										<div>
											<>
												<p class="eyebrow">02 / FIND YOUR FIT</p>
												<h2>{l("選擇合作的起點。", "Find your starting point.")}</h2>
											</>
										</div>
										<p>
											{l("先選一個方案，再視需要加入品項。還沒決定也沒關係，可以直接和我們討論。", "Choose a tier, then add options as needed. You can also start a conversation before deciding.")}
										</p>
									</>
								</div>
								<p class="reference-note">
									{l(
										"2027 方案尚未公布。以下 A–D 為討論用合作方向，正式名稱、價格、權益與截止日均待確認，可試選表達需求，不構成預訂。",
										"2027 plans have not been announced. A–D are discussion options. Official names, prices, benefits, and deadlines are pending. You can try selecting them to express interest; nothing is reserved."
									)}
								</p>
								<div class="tier-grid">
									{tiers.map(tier => (
										<article class="tier-card" data-tier-card={tier.id}>
											<p class="tier-kicker">{tier.name_en.toUpperCase()}</p>
											<h3>{en ? tier.name_en.replace(" Tier", "") : tier.name_zh}</h3>
											<p class="tier-purpose">{tierIntent(tier)}</p>
											<div class="tier-price">
												{displayPrice(tier.price)}
												<small>{l("2027 合作方案規劃中", "2027 plan under development")}</small>
											</div>
											<ul>
												<li>
													{l("合作權益", "Partner benefits")}
													<strong>{l("待確認", "Pending")}</strong>
												</li>
												<li>
													{l("適用品項與提供數量", "Options and quantities")}
													<strong>{l("待確認", "Pending")}</strong>
												</li>
												<li>
													{l("贊助截止日", "Sponsorship deadline")}
													<strong>{l("待公布", "TBA")}</strong>
												</li>
											</ul>
											<button class="button tier-select" data-tier={tier.id} aria-pressed="false">
												{l("加入合作清單", "Add to proposal")} <span>＋</span>
											</button>
										</article>
									))}
								</div>
								<details class="comparison">
									<>
										<summary>
											{l("完整權益比較", "Compare all benefits")}
											<span>{l("手機可左右滑動表格", "Swipe table on mobile")}</span>
										</summary>
										<div class="table-scroll" tabindex="0" role="region" aria-label={l("方案權益比較表，可橫向捲動", "Scrollable plan comparison")}>
											<table>
												<>
													<caption class="sr-only">{l("贊助方案參考權益比較", "Reference sponsorship benefits")}</caption>
													<thead>
														<tr>
															<th scope="col">{l("合作權益", "Benefit")}</th>
															{tiers.map(t => (
																<th scope="col">
																	{en ? t.name_en : t.name_zh}
																	<small>{displayPrice(t.price)}</small>
																</th>
															))}
														</tr>
													</thead>
													<tbody>
														{benefits.map((benefit, i) => (
															<tr>
																<th scope="row">{benefitName(benefit)}</th>
																{tiers.map(t => {
																	const q = t.benefits[i]?.quantity;
																	return (
																		<td>
																			{q === "待確認" || !q ? (
																				<span class="pending-cell">{l("待確認", "Pending")}</span>
																			) : q === "O" ? (
																				<span aria-label={l("包含", "Included")}>✓</span>
																			) : q === "0" ? (
																				<span aria-label={l("不包含", "Not included")}>—</span>
																			) : (
																				q
																			)}
																		</td>
																	);
																})}
															</tr>
														))}
													</tbody>
												</>
											</table>
										</div>
										<p class="source-note">
											{l(
												"比較表列出需要確認的合作權益。待確認不代表包含或不含；正式資料取得後才會呈現數量與差異。",
												"This table lists benefits to confirm. Pending does not mean included or excluded. Quantities and differences will appear after official data is confirmed."
											)}
										</p>
									</>
								</details>
								<a class="text-link" href="#contact">
									{l("不確定怎麼選？告訴我們你的目標", "Need help choosing? Tell us your goals")} ↗
								</a>
							</div>
						</section>

						<section id="dream" class="dream-section section-pad">
							<div class="wrap dream-grid">
								<>
									<div>
										<>
											<p class="eyebrow">OPEN POSSIBILITIES / 2027</p>
											<h2>
												{l("讓想來的學生，", "Help students")}
												<br />
												<em>{l("有機會抵達。", "get here.")}</em>
											</h2>
											<p class="dream-lead">{l("開源築夢計畫", "Student support program")}</p>
											<p>
												{l(
													"一張票，可能還不夠。交通與住宿費用，也可能成為學生參與技術交流的門檻。我們希望與你一起，支持有經濟需求的學生走進 SITCON。",
													"A ticket is only the beginning. Travel and accommodation can still stand between a student and the community. Help us make SITCON more accessible to students with financial needs."
												)}
											</p>
											<div class="dream-compare">
